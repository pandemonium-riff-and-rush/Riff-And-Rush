# Copia este archivo como .env.local y pega los datos de tu proyecto:
# Supabase → Project Settings → API (o "Data API" / "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La "publishable key" (sb_publishable_...) o la antigua "anon public key". NUNCA la service_role / secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
